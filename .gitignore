# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next-start.*.log
.next-start.*.pid

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local uploads and generated docs
/uploads
/prisma/dev.db
/.local-data

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
